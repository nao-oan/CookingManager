# 値はコミットしない（NFR-7）。このファイルはキー名の見本のみ。
#
# クラウドの Supabase プロジェクトを使う場合は、ダッシュボードの
# Project Settings > API と Database から値を取得する。
# ローカル（Docker）を使う場合は `npm run db:start` の出力を使う。

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API > Project API keys > service_role
# サーバー側でのみ使う。クライアントへ露出させない
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings > Database > Connection string > URI
# マイグレーションの適用に使う。パスワードを含むので取り扱いに注意する
DATABASE_URL=

# E2E テスト用のアカウント（値はリポジトリに置かない / NFR-7）
E2E_EMAIL=
E2E_PASSWORD=

# 画面確認用のアカウント（E2E 用とは分ける。値はリポジトリに置かない / NFR-7）
DEMO_EMAIL=
DEMO_PASSWORD=
